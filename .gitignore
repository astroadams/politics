# Python cache and environments
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.env
.env.*
.venv/
venv/

# Editors/OS
.vscode/
*.code-workspace
.DS_Store

# Generated artifacts
*.pdf

# Vector tiles and databases
tiles/
*.mbtiles

# Large data artifacts (keep raw small CSVs tracked)
