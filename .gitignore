data/precincts-with-results.geojson
data/**/*-precinct-*.tab
data/**/*-precinct-*.csv
data/**/precincts/**/*.geojson
data/states/by_state/*/counties_*.geojson

# Shapefile bundles
data/**/*.shp
data/**/*.dbf
data/**/*.shx
data/**/*.prj
data/**/*.cpg
